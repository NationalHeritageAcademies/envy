# Template for local environment overrides. Copy to .env.local and fill in.
# .env.local is gitignored so secrets stay on your machine.
#
# Nothing here is needed for `npm run dev`, `npm test`, or unsigned local
# packaging — every var below is RELEASE-ONLY. CI releases read the same
# values from GitHub Actions secrets (see .github/workflows/release.yml);
# local releases upload via the `gh` CLI (`gh auth login`), so no release
# credentials live here either.

# Azure Trusted Signing (release-only) — used by scripts/sign-windows.cjs to Authenticode-sign
# the Windows .exe and uninstaller during `npm run package`. Without these the
# Windows installer ships unsigned and Defender quarantines it mid-install.
#
# Prereq: `brew install jsign` (the cross-platform signer that talks to the
# Trusted Signing REST API — no Wine, no Windows VM needed).
#
# Service principal: create an App Registration in Entra ID, generate a client
# secret, and grant it the "Artifact Signing Certificate Profile Signer" role
# on the certificate profile resource in Azure.
#
# For local test builds you can skip signing entirely with SKIP_WIN_SIGN=1
# (the `package:win:test` script does this for you).
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Region endpoint of the Trusted Signing account (e.g. https://eus.codesigning.azure.net
# for East US, https://wus.codesigning.azure.net for West US).
TRUSTED_SIGNING_ENDPOINT=
# Artifact Signing account name (e.g. melodic-dev-signing).
TRUSTED_SIGNING_ACCOUNT=
# Certificate profile name under the account (e.g. envy-cert-profile).
TRUSTED_SIGNING_PROFILE=
